{
  "name": "electron-file-explorer",
  "version": "1.0.0",
  "description": "Практическая работа №3: файловый менеджер на Electron (вариант 1 — выбор каталога)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "keywords": [],
  "author": "Ахмедханов Магомедхан Русланович <ТРПО23-2>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.fa.student.fileexplorer",
    "productName": "Electron File Explorer",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "mac": {
      "target": "dmg"
    },
    "publish": []
  }
}